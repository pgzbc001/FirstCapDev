{
  "name": "FirstCapDev",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/http-client": "^4.9.1",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-master": "cds watch --open master/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy FirstCapDev --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "cds": {
    "server": {
      "index": true
    },
    "requires": {
      "[production]": {
        "auth": "xsuaa"
      },
      "db": {
        "kind": "hana"
      },
      "connectivity": true,
      "destinations": true,
      "html5-repo": false
    }
  },
  "workspaces": [
    "app/*"
  ]
}
